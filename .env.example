# ==========================================
# SMART PARCEL BOX — ENVIRONMENT TEMPLATE
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If local MongoDB is unavailable, backend seamlessly uses in-memory database
MONGODB_URI=mongodb://localhost:27017/smart_parcel_box

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=parcelbox_server
MQTT_PASSWORD=secure_broker_password_replace
MQTT_CLIENT_ID=spb_backend_service
MQTT_QOS=1

# Hardware & Telemetry Defaults
DEFAULT_DEVICE_ID=BOX-001
STALE_DATA_TIMEOUT_MS=15000

# Client Configuration (apps/web)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

